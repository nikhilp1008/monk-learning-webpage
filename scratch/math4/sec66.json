    {
      "seq": 6,
      "type": "formula",
      "latex": "1+i=\\sqrt2\\angle\\tfrac{\\pi}{4},\\ 1+i\\sqrt3=2\\angle\\tfrac{\\pi}{3},\\ \\sqrt3+i=2\\angle\\tfrac{\\pi}{6}",

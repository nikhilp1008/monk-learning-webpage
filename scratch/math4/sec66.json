      "type": "formula",
      "latex": "\\text{quadrant arg: I}\\!\\to\\!\\alpha,\\ \\text{II}\\!\\to\\!\\pi-\\alpha,\\ \\text{III}\\!\\to\\!\\alpha-\\pi,\\ \\text{IV}\\!\\to\\!-\\alpha",
      "emphasis": "normal",

    },
    {
      "seq": 3,
      "type": "formula",
      "latex": "\\sqrt{-a}\\sqrt{-b}=-\\sqrt{ab}\\ (a,b>0);\\quad (1+i)^{2}=2i,\\ (1-i)^{2}=-2i",
      "emphasis": "normal",
      "reveal_at": 17
    },
    {
      "seq": 4,
      "text": "$\\bar z$ flips imaginary sign; $-z$ flips both. Order undefined on $\\mathbb{C}$.",
      "type": "note",
      "style": "red-margin",
      "emphasis": "normal",
